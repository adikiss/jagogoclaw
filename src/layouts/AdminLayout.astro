---
import '../styles/global.css';
import Logo from '@components/ui/Logo.astro';

interface Props {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;

const icons = {
  home: '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/></svg>',
  users: '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>',
  book: '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>',
  tag: '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/></svg>',
  page: '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/></svg>',
};

const nav = [
  { href: '/dashboard', label: 'Dashboard', icon: icons.home, soon: false, exact: true },
  { href: '/dashboard/peserta', label: 'Peserta', icon: icons.users, soon: false, exact: false },
  { href: '/dashboard/pembayaran', label: 'Pembayaran & Harga', icon: icons.tag, soon: false, exact: false },
  { href: '/dashboard/kurikulum', label: 'Kurikulum', icon: icons.book, soon: false, exact: false },
  { href: '/dashboard/halaman-depan', label: 'Halaman Depan', icon: icons.page, soon: true, exact: false },
];

const path = Astro.url.pathname;
const isActive = (item: (typeof nav)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/images/goclaw-icon.png" />
    <title>{title} — Admin Jago GoClaw</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden w-64 flex-none flex-col border-r border-slate-200 bg-white md:flex">
        <div class="flex h-16 flex-none items-center border-b border-slate-100 px-5">
          <Logo size={26} />
        </div>
        <nav class="flex-1 space-y-1 overflow-y-auto p-3">
          {nav.map((item) =>
            item.soon ? (
              <span class="flex cursor-not-allowed items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-slate-400" title="Tahap berikutnya">
                <span class="flex items-center gap-3">
                  <Fragment set:html={item.icon} />
                  {item.label}
                </span>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Segera</span>
              </span>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                  isActive(item) ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
                ]}
                aria-current={isActive(item) ? 'page' : undefined}
              >
                <Fragment set:html={item.icon} />
                {item.label}
              </a>
            )
          )}
        </nav>
        <div class="space-y-1 border-t border-slate-100 p-3">
          <a href="/" target="_blank" rel="noopener" class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            Lihat Situs
          </a>
          <form method="POST" action="/api/admin/logout">
            <button type="submit" class="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-left text-sm font-medium text-rose-600 transition-colors hover:bg-rose-50">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/></svg>
              Keluar
            </button>
          </form>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-30 border-b border-slate-200 bg-white md:hidden">
          <div class="flex h-14 items-center justify-between px-4">
            <Logo size={22} />
            <form method="POST" action="/api/admin/logout">
              <button type="submit" class="rounded-lg p-2 text-rose-600 hover:bg-rose-50" aria-label="Keluar">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/></svg>
              </button>
            </form>
          </div>
          <nav class="flex gap-1 overflow-x-auto border-t border-slate-100 px-2 py-2">
            {nav.filter((i) => !i.soon).map((item) => (
              <a
                href={item.href}
                class:list={[
                  'flex-none rounded-lg px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors',
                  isActive(item) ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-50',
                ]}
              >
                {item.label}
              </a>
            ))}
            <span class="flex-none rounded-lg px-3 py-1.5 text-sm font-medium whitespace-nowrap text-slate-400">Halaman Depan · Segera</span>
          </nav>
        </header>

        <main class="flex-1 p-4 sm:p-6 lg:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
