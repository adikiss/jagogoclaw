---
export const prerender = false;

import '../styles/global.css';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { getDB } from '@db/client';
import { getPrice } from '@lib/settings';
import { formatIDR } from '@db/types';

const error = Astro.url.searchParams.get('error');
const db = getDB(Astro.locals);
const price = await getPrice(db);

const errorMessages: Record<string, string> = {
  dup: 'Email sudah terdaftar. Silakan masuk.',
  missing: 'Semua field wajib diisi dengan benar.',
  short: 'Password minimal 6 karakter.',
};

const inputClass =
  'mt-1.5 block w-full rounded-xl border-0 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/goclaw-icon.png" />
    <title>Daftar — Jago GoClaw</title>
  </head>
  <body class="min-h-screen bg-white antialiased">
    <Navbar />
    <main class="bg-gradient-to-b from-brand-50/60 to-white py-12 sm:py-16">
      <div class="mx-auto max-w-xl px-4 sm:px-6">
        <div class="text-center">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Daftar Pelatihan</h1>
          <p class="mt-2 text-slate-600">
            Isi data di bawah, lalu lanjut ke instruksi pembayaran.
          </p>
          <p class="mt-3 inline-flex items-center rounded-full bg-white px-4 py-1.5 text-sm font-bold text-brand-700 ring-1 ring-brand-200">
            {formatIDR(price)} · Akses selamanya
          </p>
        </div>

        {error && errorMessages[error] && (
          <div class="mt-6 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 ring-1 ring-inset ring-rose-200">
            {errorMessages[error]}
          </div>
        )}

        <div class="mt-8 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70 sm:p-8">
          <form method="POST" action="/api/participant/register" class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-700">Nama Lengkap <span class="text-rose-500">*</span></label>
              <input type="text" name="name" id="name" required placeholder="Nama lengkap" class={inputClass} />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email <span class="text-rose-500">*</span></label>
              <input type="email" name="email" id="email" required placeholder="nama@email.com" class={inputClass} />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700">WhatsApp</label>
              <input type="tel" name="phone" id="phone" placeholder="08xxxxxxxxxx" class={inputClass} />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-700">Password <span class="text-rose-500">*</span></label>
              <input type="password" name="password" id="password" required minlength="6" placeholder="Minimal 6 karakter" class={inputClass} />
              <p class="mt-1.5 text-xs text-slate-400">Dipakai untuk masuk ke area kursus setelah pembayaran diverifikasi.</p>
            </div>
            <button
              type="submit"
              class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
            >
              Daftar & Lanjut ke Pembayaran
            </button>
          </form>

          <p class="mt-6 text-center text-sm text-slate-500">
            Sudah punya akun?
            <a href="/masuk" class="font-semibold text-brand-600 hover:text-brand-700">Masuk di sini</a>
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
