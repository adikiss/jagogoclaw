---
export const prerender = false;

import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB } from '@db/client';
import type { CourseModule } from '@db/types';

const db = getDB(Astro.locals);
const { results: modules } = await db
  .prepare('SELECT * FROM modules ORDER BY day ASC, num ASC')
  .all<CourseModule>();

const msg = Astro.url.searchParams.get('msg');
const error = Astro.url.searchParams.get('error');

const flash: Record<string, string> = {
  added: 'Modul ditambahkan.',
  updated: 'Modul diperbarui.',
  deleted: 'Modul dihapus.',
};
const errors: Record<string, string> = {
  invalid: 'Data modul tidak valid — hari, nomor, judul, dan deskripsi wajib benar.',
  dup: 'Kombinasi hari + nomor modul sudah dipakai.',
  notfound: 'Modul tidak ditemukan.',
};

const days = [1, 2, 3].map((d) => ({ day: d, items: modules.filter((m) => m.day === d) }));
const inputClass =
  'w-full rounded-lg border-0 px-3 py-2 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500';
---

<AdminLayout title="Kurikulum">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Kurikulum</h1>
      <p class="mt-1 text-sm text-slate-500">Kelola modul & tautan video yang ditampilkan di area kursus peserta.</p>
    </div>
    <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-slate-600 ring-1 ring-slate-200">{modules.length} modul</span>
  </div>

  {msg && flash[msg] && (
    <div class="mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 ring-1 ring-inset ring-emerald-200">{flash[msg]}</div>
  )}
  {error && errors[error] && (
    <div class="mt-4 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 ring-1 ring-inset ring-rose-200">{errors[error]}</div>
  )}

  <div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <h2 class="text-sm font-semibold text-slate-900">Tambah Modul</h2>
    <form method="POST" action="/api/admin/modules" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <select name="day" required class={inputClass}>
        <option value="1">Hari 1</option>
        <option value="2">Hari 2</option>
        <option value="3">Hari 3</option>
      </select>
      <input type="number" name="num" required min="1" placeholder="No. modul" class={inputClass} />
      <input type="text" name="title_id" required placeholder="Judul (ID)" class={inputClass} />
      <input type="text" name="title_en" placeholder="Judul (EN)" class={inputClass} />
      <input type="text" name="desc_id" required placeholder="Deskripsi singkat (ID)" class="sm:col-span-2 input w-full rounded-lg border-0 px-3 py-2 text-sm shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500" />
      <input type="text" name="desc_en" placeholder="Deskripsi (EN)" class={inputClass} />
      <input type="url" name="video_url" placeholder="URL video YouTube" class={inputClass} />
      <div class="sm:col-span-2 lg:col-span-4">
        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Tambah
        </button>
      </div>
    </form>
  </div>

  {days.map(({ day, items }) => (
    <div class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-wide text-slate-400">Hari {day}</h2>
      <div class="mt-3 space-y-3">
        {items.map((m) => (
          <div class="rounded-2xl bg-white p-4 ring-1 ring-slate-200/70 sm:p-5">
            <form method="POST" action={`/api/admin/modules/${m.id}`} class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              <div class="flex items-center gap-2 lg:col-span-1">
                <span class="inline-flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">{m.num}</span>
                <select name="day" class={inputClass}>
                  <option value="1" selected={m.day === 1}>Hari 1</option>
                  <option value="2" selected={m.day === 2}>Hari 2</option>
                  <option value="3" selected={m.day === 3}>Hari 3</option>
                </select>
              </div>
              <input type="number" name="num" value={m.num} min="1" required class={inputClass} title="Nomor modul" />
              <input type="text" name="title_id" value={m.title_id} required class={inputClass} title="Judul ID" />
              <input type="text" name="title_en" value={m.title_en} class={inputClass} title="Judul EN" />
              <input type="text" name="desc_id" value={m.desc_id} required class={`${inputClass} sm:col-span-2`} title="Deskripsi ID" />
              <input type="text" name="desc_en" value={m.desc_en} class={inputClass} title="Deskripsi EN" />
              <input type="url" name="video_url" value={m.video_url ?? ''} placeholder="URL YouTube (kosong = belum ada)" class={`${inputClass} ${m.video_url ? 'ring-emerald-300' : ''}`} title="URL video" />
              <div class="flex items-center justify-between gap-2 sm:col-span-2 lg:col-span-4">
                <span class:list={['text-xs font-semibold', m.video_url ? 'text-emerald-600' : 'text-slate-400']}>
                  {m.video_url ? '✓ Video terpasang' : 'Belum ada video'}
                </span>
                <div class="flex gap-2">
                  <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-700">Simpan</button>
                </div>
              </div>
            </form>
            <form method="POST" action={`/api/admin/modules/${m.id}/delete`} class="mt-2 border-t border-slate-100 pt-2" onsubmit="return confirm('Hapus modul ini?')">
              <button type="submit" class="text-xs font-semibold text-rose-500 hover:text-rose-600">Hapus modul</button>
            </form>
          </div>
        ))}
        {items.length === 0 && (
          <p class="rounded-2xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-400">Belum ada modul di hari ini.</p>
        )}
      </div>
    </div>
  ))}
</AdminLayout>
