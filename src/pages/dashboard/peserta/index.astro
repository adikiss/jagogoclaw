---
export const prerender = false;

import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB } from '@db/client';
import {
  statusLabels,
  paymentLabels,
  formatDate,
  isParticipantStatus,
  type Participant,
} from '@db/types';

const db = getDB(Astro.locals);

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const status = Astro.url.searchParams.get('status') ?? '';
const msg = Astro.url.searchParams.get('msg');
const error = Astro.url.searchParams.get('error');

let sql = 'SELECT * FROM participants';
const where: string[] = [];
const params: unknown[] = [];

if (q) {
  where.push('(name LIKE ? OR email LIKE ? OR phone LIKE ?)');
  const like = `%${q}%`;
  params.push(like, like, like);
}
if (status && isParticipantStatus(status)) {
  where.push('status = ?');
  params.push(status);
}
if (where.length > 0) sql += ' WHERE ' + where.join(' AND ');
sql += ' ORDER BY created_at DESC, id DESC';

const { results: participants } = await db.prepare(sql).bind(...params).all<Participant>();

const flashMessages: Record<string, string> = {
  added: 'Peserta berhasil ditambahkan.',
  updated: 'Perubahan berhasil disimpan.',
  deleted: 'Peserta berhasil dihapus.',
  verified: 'Pembayaran diverifikasi — peserta kini bisa mengakses kursus.',
};
const errorMessages: Record<string, string> = {
  missing: 'Nama dan email wajib diisi.',
  dup: 'Email sudah terdaftar.',
  notfound: 'Peserta tidak ditemukan.',
};

const inputClass =
  'mt-1.5 block w-full rounded-xl border-0 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500';
---

<AdminLayout title="Peserta">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Peserta</h1>
      <p class="mt-1 text-sm text-slate-500">Kelola data peserta pelatihan.</p>
    </div>
    <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-slate-600 ring-1 ring-slate-200">
      {participants.length} peserta
    </span>
  </div>

  {msg && flashMessages[msg] && (
    <div class="mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 ring-1 ring-inset ring-emerald-200">
      {flashMessages[msg]}
    </div>
  )}
  {error && errorMessages[error] && (
    <div class="mt-4 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 ring-1 ring-inset ring-rose-200">
      {errorMessages[error]}
    </div>
  )}

  <div class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-slate-200/70 sm:p-6">
    <h2 class="text-sm font-semibold text-slate-900">Tambah Peserta</h2>
    <form method="POST" action="/api/admin/participants" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Nama <span class="text-rose-500">*</span></label>
        <input type="text" name="name" id="name" required placeholder="Nama lengkap" class={inputClass} />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-700">Email <span class="text-rose-500">*</span></label>
        <input type="email" name="email" id="email" required placeholder="nama@email.com" class={inputClass} />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-slate-700">WhatsApp</label>
        <input type="tel" name="phone" id="phone" placeholder="08xxxxxxxxxx" class={inputClass} />
      </div>
      <div>
        <label for="status" class="block text-sm font-medium text-slate-700">Status</label>
        <select name="status" id="status" class={inputClass}>
          <option value="pending" selected>Menunggu</option>
          <option value="active">Aktif</option>
          <option value="cancelled">Batal</option>
        </select>
      </div>
      <div>
        <label for="payment_status" class="block text-sm font-medium text-slate-700">Pembayaran</label>
        <select name="payment_status" id="payment_status" class={inputClass}>
          <option value="unpaid" selected>Belum Bayar</option>
          <option value="paid">Lunas</option>
        </select>
      </div>
      <div class="sm:col-span-2 lg:col-span-1">
        <label for="notes" class="block text-sm font-medium text-slate-700">Catatan</label>
        <input type="text" name="notes" id="notes" placeholder="Opsional" class={inputClass} />
      </div>
      <div class="sm:col-span-2 lg:col-span-3">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Tambah
        </button>
      </div>
    </form>
  </div>

  <div class="mt-6 rounded-2xl bg-white ring-1 ring-slate-200/70">
    <form method="GET" action="/dashboard/peserta" class="flex flex-wrap gap-3 border-b border-slate-100 px-5 py-4">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Cari nama, email, WA..."
        class="w-full max-w-xs rounded-xl border-0 px-3.5 py-2 text-sm shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500"
      />
      <select name="status" class="rounded-xl border-0 px-3 py-2 text-sm shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-brand-500">
        <option value="" selected={status === ''}>Semua status</option>
        <option value="pending" selected={status === 'pending'}>Menunggu</option>
        <option value="active" selected={status === 'active'}>Aktif</option>
        <option value="cancelled" selected={status === 'cancelled'}>Batal</option>
      </select>
      <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-700">
        Filter
      </button>
    </form>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50/70 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">Nama</th>
            <th class="px-5 py-3 font-semibold">Kontak</th>
            <th class="px-5 py-3 font-semibold">Status</th>
            <th class="px-5 py-3 font-semibold">Bayar</th>
            <th class="px-5 py-3 font-semibold">Terdaftar</th>
            <th class="px-5 py-3 text-right font-semibold">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {participants.map((p) => (
            <tr class="hover:bg-slate-50/60">
              <td class="px-5 py-3">
                <p class="font-medium text-slate-800">{p.name}</p>
                {p.notes && <p class="text-xs text-slate-400">{p.notes}</p>}
              </td>
              <td class="px-5 py-3 text-slate-600">
                <p>{p.email}</p>
                {p.phone && <p class="text-xs text-slate-400">{p.phone}</p>}
              </td>
              <td class="px-5 py-3">
                <span class:list={[
                  'inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset',
                  p.status === 'active' && 'bg-emerald-50 text-emerald-700 ring-emerald-200',
                  p.status === 'pending' && 'bg-amber-50 text-amber-700 ring-amber-200',
                  p.status === 'cancelled' && 'bg-slate-100 text-slate-500 ring-slate-200',
                ]}>
                  {statusLabels[p.status]}
                </span>
              </td>
              <td class="px-5 py-3">
                <span class:list={[
                  'inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset',
                  p.payment_status === 'paid' && 'bg-emerald-50 text-emerald-700 ring-emerald-200',
                  p.payment_status === 'unpaid' && 'bg-rose-50 text-rose-700 ring-rose-200',
                ]}>
                  {paymentLabels[p.payment_status]}
                </span>
                {p.payment_status === 'unpaid' && p.payment_confirmed_at && p.payment_method && (
                  <p class="mt-1 text-[11px] leading-snug text-amber-600">
                    Klaim: {p.payment_method} · {p.payment_confirmed_at.slice(0, 16).replace('T', ' ')}
                  </p>
                )}
              </td>
              <td class="px-5 py-3 text-slate-500">{formatDate(p.created_at)}</td>
              <td class="px-5 py-3">
                <div class="flex flex-wrap justify-end gap-2">
                  {p.payment_status === 'unpaid' && (
                    <form method="POST" action={`/api/admin/participants/${p.id}/verify`}>
                      <button type="submit" class="rounded-lg bg-emerald-600 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700" title="Tandai lunas & aktifkan akses">
                        ✓ Verifikasi
                      </button>
                    </form>
                  )}
                  <a href={`/dashboard/peserta/${p.id}`} class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50">
                    Edit
                  </a>
                  <form method="POST" action={`/api/admin/participants/${p.id}/delete`} onsubmit="return confirm('Hapus peserta ini?')">
                    <button type="submit" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-rose-600 ring-1 ring-inset ring-rose-200 transition-colors hover:bg-rose-50">
                      Hapus
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
          {participants.length === 0 && (
            <tr>
              <td colspan="6" class="px-5 py-10 text-center text-slate-400">Tidak ada peserta yang cocok.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
