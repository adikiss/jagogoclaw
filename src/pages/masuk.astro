---
export const prerender = false;

import '../styles/global.css';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { PARTICIPANT_COOKIE, verifyParticipantToken, getSecret } from '@lib/auth';
import { getDB } from '@db/client';
import type { Participant } from '@db/types';

const token = Astro.cookies.get(PARTICIPANT_COOKIE)?.value;
const secret = getSecret(Astro.locals, 'SESSION_SECRET', 'insecure-dev-secret');
const participantId = await verifyParticipantToken(token, secret);

if (participantId !== null) {
  const db = getDB(Astro.locals);
  const p = await db
    .prepare('SELECT payment_status, status FROM participants WHERE id = ?')
    .bind(participantId)
    .first<Pick<Participant, 'payment_status' | 'status'>>();
  if (p && p.payment_status === 'paid' && p.status === 'active') return Astro.redirect('/course');
  if (p) return Astro.redirect('/daftar/pembayaran');
}

const error = Astro.url.searchParams.get('error');
const inputClass =
  'mt-1.5 block w-full rounded-xl border-0 px-3.5 py-2.5 text-sm text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-brand-500';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/goclaw-icon.png" />
    <title>Masuk — Jago GoClaw</title>
  </head>
  <body class="min-h-screen bg-white antialiased">
    <Navbar />
    <main class="flex min-h-[calc(100vh-8rem)] items-center justify-center bg-gradient-to-b from-brand-50/60 to-white py-12">
      <div class="w-full max-w-md px-4">
        <div class="text-center">
          <img src="/images/goclaw-icon.png" alt="GoClaw" width="64" height="64" class="mx-auto h-16 w-16 rounded-2xl object-contain shadow-md ring-1 ring-slate-200/60" />
          <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900">Masuk Area Kursus</h1>
          <p class="mt-1 text-sm text-slate-500">Gunakan email & password yang Anda daftarkan.</p>
        </div>

        {error === '1' && (
          <div class="mt-6 rounded-xl bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 ring-1 ring-inset ring-rose-200">
            Email atau password salah.
          </div>
        )}

        <div class="mt-8 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200/70 sm:p-8">
          <form method="POST" action="/api/participant/login" class="space-y-4">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
              <input type="email" name="email" id="email" required autofocus placeholder="nama@email.com" class={inputClass} />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
              <input type="password" name="password" id="password" required placeholder="••••••••" class={inputClass} />
            </div>
            <button
              type="submit"
              class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
            >
              Masuk
            </button>
          </form>

          <p class="mt-6 text-center text-sm text-slate-500">
            Belum daftar?
            <a href="/daftar" class="font-semibold text-brand-600 hover:text-brand-700">Daftar sekarang</a>
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
