---
export const prerender = false;

import '../../styles/global.css';
import Logo from '@components/ui/Logo.astro';
import { getDB } from '@db/client';
import type { CourseModule, Participant } from '@db/types';
import { parseVideoUrl, buildEmbedUrl } from '@lib/video';

const db = getDB(Astro.locals);
const participantId = Astro.locals.participantId!;

const participant = await db
  .prepare('SELECT * FROM participants WHERE id = ?')
  .bind(participantId)
  .first<Participant>();

if (!participant) return Astro.redirect('/masuk');
if (participant.payment_status !== 'paid' || participant.status !== 'active') {
  return Astro.redirect('/daftar/pembayaran');
}

const { results: modules } = await db
  .prepare('SELECT * FROM modules ORDER BY day ASC, num ASC')
  .all<CourseModule>();

const selectedId = Number(Astro.url.searchParams.get('m'));
const selected =
  modules.find((m) => m.id === selectedId) ?? modules.find((m) => m.video_url) ?? modules[0] ?? null;

const selectedRef = selected?.video_url ? parseVideoUrl(selected.video_url) : null;
const embedUrl = selectedRef ? await buildEmbedUrl(selectedRef, Astro.locals) : null;

const selectedIndex = selected ? modules.findIndex((m) => m.id === selected.id) : -1;
const prevModule = selectedIndex > 0 ? modules[selectedIndex - 1] : null;
const nextModule = selectedIndex >= 0 && selectedIndex < modules.length - 1 ? modules[selectedIndex + 1] : null;
const positionLabel = selectedIndex >= 0 ? `Modul ${selectedIndex + 1} dari ${modules.length}` : '';

const dayTitles: Record<number, string> = { 1: 'Hari 1 — Dasar', 2: 'Hari 2 — Praktik', 3: 'Hari 3 — Advanced' };
const days = [1, 2, 3].map((d) => ({ day: d, title: dayTitles[d], items: modules.filter((m) => m.day === d) }));
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/images/goclaw-icon.png" />
    <title>Area Kursus — Jago GoClaw</title>
  </head>
  <body class="min-h-screen bg-slate-100 antialiased">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href="/" aria-label="Jago GoClaw"><Logo size={24} /></a>
        <div class="flex items-center gap-3">
          <span class="hidden text-sm font-medium text-slate-600 sm:block">{participant.name}</span>
          <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">
            {participant.payment_status === 'paid' ? 'Lunas' : 'Belum Lunas'}
          </span>
          <form method="POST" action="/api/participant/logout">
            <button type="submit" class="rounded-lg px-2.5 py-1.5 text-sm font-semibold text-rose-600 hover:bg-rose-50">Keluar</button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:py-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_340px]">
        <div>
          {selected ? (
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/70">
              <div class="aspect-video w-full bg-slate-900">
                {embedUrl ? (
                  <iframe
                    src={embedUrl}
                    title={selected.title_id}
                    class="h-full w-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <div class="flex h-full flex-col items-center justify-center gap-2 text-slate-400">
                    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
                    <p class="text-sm font-medium">Video belum tersedia</p>
                  </div>
                )}
              </div>
              <div class="p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Modul {selected.num} · {dayTitles[selected.day]}</p>
                <h1 class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl">{selected.title_id}</h1>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{selected.desc_id}</p>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 p-4 sm:px-6">
                {prevModule ? (
                  <a
                    href={`/course?m=${prevModule.id}`}
                    class="group inline-flex max-w-[45%] items-center gap-2 rounded-xl px-3 py-2.5 text-left ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50"
                  >
                    <svg class="h-4 w-4 flex-none text-slate-400 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
                    <span class="min-w-0">
                      <span class="block text-[11px] font-semibold uppercase tracking-wide text-slate-400">Sebelumnya</span>
                      <span class="block truncate text-sm font-semibold text-slate-700">{prevModule.num}. {prevModule.title_id}</span>
                    </span>
                  </a>
                ) : (
                  <span class="text-xs text-slate-300">Ini modul pertama</span>
                )}

                <span class="hidden text-xs font-medium text-slate-400 sm:block">{positionLabel}</span>

                {nextModule ? (
                  <a
                    href={`/course?m=${nextModule.id}`}
                    class="group inline-flex max-w-[45%] items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-right text-white shadow-lg shadow-brand-600/20 transition-colors hover:bg-brand-700"
                  >
                    <span class="min-w-0">
                      <span class="block text-[11px] font-semibold uppercase tracking-wide text-white/70">Selanjutnya</span>
                      <span class="block truncate text-sm font-semibold">{nextModule.num}. {nextModule.title_id}</span>
                    </span>
                    <svg class="h-4 w-4 flex-none transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
                  </a>
                ) : (
                  <span class="text-xs font-medium text-emerald-600">Selesai — semua modul sudah ditonton 🎉</span>
                )}
              </div>
            </div>
          ) : (
            <div class="flex flex-col items-center justify-center rounded-2xl bg-white p-12 text-center shadow-sm ring-1 ring-slate-200/70">
              <p class="text-lg font-bold text-slate-700">Modul belum tersedia</p>
              <p class="mt-1 text-sm text-slate-500">Video akan segera diunggah oleh admin.</p>
            </div>
          )}
        </div>

        <aside class="lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
          <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200/70 sm:p-5">
            <p class="px-1 text-sm font-bold text-slate-900">Daftar Modul</p>
            <nav class="mt-3 space-y-5">
              {days.map((group) => (
                <div>
                  <p class="px-1 text-xs font-semibold uppercase tracking-wide text-slate-400">{group.title}</p>
                  <ul class="mt-2 space-y-1">
                    {group.items.map((m) => (
                      <li>
                        <a
                          href={`/course?m=${m.id}`}
                          class:list={[
                            'flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors',
                            selected?.id === m.id
                              ? 'bg-brand-50 font-semibold text-brand-700'
                              : 'text-slate-600 hover:bg-slate-50',
                          ]}
                          aria-current={selected?.id === m.id ? 'page' : undefined}
                        >
                          <span class:list={[
                            'flex h-6 w-6 flex-none items-center justify-center rounded-md text-xs font-bold',
                            selected?.id === m.id ? 'bg-brand-600 text-white' : 'bg-slate-100 text-slate-500',
                          ]}>{m.num}</span>
                          <span class="flex-1 leading-snug">{m.title_id}</span>
                          {!m.video_url && (
                            <span class="flex-none text-[10px] font-semibold uppercase text-slate-300" title="Belum ada video">soon</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </nav>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
