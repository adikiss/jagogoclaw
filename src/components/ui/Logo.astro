---
import { site } from '@data/site';

interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<span
  class:list={['inline-flex items-center font-extrabold tracking-tight', className]}
  style={`font-size:${Math.round(size * 0.85)}px;line-height:1`}
  aria-label={`${site.name} — home`}
>
  <img
    src="/images/goclaw-icon.png"
    alt=""
    width={size}
    height={size}
    class="object-contain"
    style={`height:${size}px;width:${size}px`}
    loading="eager"
  />
  <span class="ml-2 text-slate-900">
    Jago<span class="text-brand-600">GoClaw</span>
  </span>
</span>
