---
import { useTranslations, getLocaleFromUrl, getAlternatePath } from '@i18n/utils';
import { locales, localeLabels } from '@i18n/ui';
import Logo from './ui/Logo.astro';
import { site } from '@data/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const year = new Date().getFullYear();

const otherLocales = locales.filter((l) => l !== locale);
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <Logo size={24} />
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-500">{t('footer.tagline')}</p>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">{t('footer.contact')}</p>
        <ul class="mt-4 space-y-2">
          <li>
            <a href={`mailto:${site.email}`} class="text-sm text-slate-500 transition-colors hover:text-brand-600">
              {site.email}
            </a>
          </li>
          <li class="flex gap-3 pt-2">
            {otherLocales.map((loc) => (
              <a
                href={getAlternatePath(Astro.url, loc)}
                hreflang={loc}
                class="rounded-md px-2 py-1 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50"
              >
                {localeLabels[loc]}
              </a>
            ))}
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-100 pt-6 sm:flex-row">
      <p class="text-xs text-slate-400">© {year} {site.name}. {t('footer.legal').replace(/^© \d{4} Jago GoClaw\.?\s*/, '')}</p>
      <p class="text-xs text-slate-400">{site.domain}</p>
    </div>
  </div>
</footer>
