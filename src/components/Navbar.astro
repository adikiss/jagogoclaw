---
import { useTranslations, getLocaleFromUrl, getAlternatePath } from '@i18n/utils';
import { locales, localeLabels } from '@i18n/ui';
import Button from './ui/Button.astro';
import Logo from './ui/Logo.astro';
import { site } from '@data/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const navLinks = [
  { href: '#curriculum', label: t('nav.curriculum') },
  { href: '#pricing', label: t('nav.pricing') },
  { href: '#instructor', label: t('nav.instructor') },
  { href: '/verifikasi', label: t('nav.verify') },
];

const otherLocale = locales.find((l) => l !== locale)!;
const langSwitchHref = getAlternatePath(Astro.url, otherLocale);
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full border-b border-transparent bg-white/80 backdrop-blur-md transition-colors duration-200"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={locale === 'id' ? '/' : `/${locale}/`} class="flex items-center" aria-label="Jago GoClaw">
      <Logo size={28} />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-600 transition-colors hover:text-brand-600"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={langSwitchHref}
        class="hidden rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-500 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-slate-50 hover:text-slate-700 sm:inline-block"
        hreflang={otherLocale}
      >
        {localeLabels[otherLocale]}
      </a>

      <div class="hidden items-center gap-3 sm:flex">
        <a
          href="/masuk"
          class="text-sm font-semibold text-slate-600 transition-colors hover:text-brand-600"
        >
          {t('nav.login')}
        </a>
        <Button href={site.registerUrl} size="sm">
          {t('nav.cta')}
        </Button>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white md:hidden">
    <div class="space-y-1 px-4 py-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50"
        >
          {link.label}
        </a>
      ))}
      <a
        href={langSwitchHref}
        class="block rounded-lg px-3 py-2 text-sm text-slate-500"
        hreflang={otherLocale}
      >
        {localeLabels[otherLocale]}
      </a>

      <div class="mt-2 border-t border-slate-100 pt-3">
        <a
          href="/masuk"
          class="mobile-menu-link block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50"
        >
          {t('nav.login')}
        </a>
        <Button href={site.registerUrl} class="mt-2 w-full">{t('nav.cta')}</Button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (window.scrollY > 8) {
      header?.classList.add('border-slate-200', 'shadow-sm');
    } else {
      header?.classList.remove('border-slate-200', 'shadow-sm');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  document.querySelectorAll('.mobile-menu-link').forEach((el) => {
    el.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.classList.add('hidden');
    });
  });
</script>
