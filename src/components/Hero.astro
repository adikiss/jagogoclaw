---
import { useTranslations, getLocaleFromUrl } from '@i18n/utils';
import Button from './ui/Button.astro';
import Badge from './ui/Badge.astro';
import { site } from '@data/site';
import { course } from '@data/site';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const stats = [
  { value: String(course.totalModules), label: t('hero.stats.modules') },
  { value: String(course.durationDays), label: t('hero.stats.days') },
  { value: course.price, label: t('hero.stats.price') },
];
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-gradient-to-br from-brand-200/40 via-violet-200/30 to-transparent blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      <div class="animate-fade-in-up flex justify-center">
        <img
          src="/images/goclaw-icon.png"
          alt="GoClaw"
          width="96"
          height="96"
          class="h-20 w-20 rounded-2xl object-contain shadow-lg shadow-brand-600/15 ring-1 ring-slate-200/60 sm:h-24 sm:w-24"
          loading="eager"
        />
      </div>

      <div class="animate-fade-in-up mt-6 flex justify-center" style="animation-delay:60ms">
        <Badge accent="brand">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          {t('hero.badge')}
        </Badge>
      </div>

      <h1 class="animate-fade-in-up mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl" style="animation-delay:120ms">
        {t('hero.title')}
      </h1>

      <p class="animate-fade-in-up mt-3 text-xl font-bold text-brand-600 sm:text-2xl" style="animation-delay:160ms">
        {t('hero.subtitle')}
      </p>

      <p class="animate-fade-in-up mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-600" style="animation-delay:200ms">
        {t('hero.description')}
      </p>

      <div class="animate-fade-in-up mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay:280ms">
        <Button href={site.registerUrl} size="lg" class="w-full sm:w-auto">
          {t('hero.cta.primary')}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <Button href="#curriculum" variant="secondary" size="lg" class="w-full sm:w-auto">
          {t('hero.cta.secondary')}
        </Button>
      </div>

      <dl class="animate-fade-in-up mt-12 grid grid-cols-3 gap-4 sm:gap-8" style="animation-delay:320ms">
        {stats.map((stat) => (
          <div class="flex flex-col items-center">
            <dt class="text-2xl font-extrabold text-brand-600 sm:text-3xl">{stat.value}</dt>
            <dd class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
